  {
    "id": "f_apply",
    "type": "function",
    "z": "tab_fake",
    "name": "Apply setpoints",
    "func": "// Like the real device should: clamp anything out of range (public broker!)\nconst clamp = (v, lo, hi, d) => (typeof v === 'number' ? Math.min(hi, Math.max(lo, v)) : d);\nconst cur = flow.get('setpoints') || { temperature_C: 30, pH: 5, rpm: 1000 };\nconst p = msg.payload || {};\nconst sp = {\n    temperature_C: clamp(p.temperature_C, 25, 35, cur.temperature_C),\n    pH: clamp(p.pH, 3, 7, cur.pH),\n    rpm: clamp(p.rpm, 500, 1500, cur.rpm)\n};\nflow.set('setpoints', sp);\nreturn { payload: sp };",
