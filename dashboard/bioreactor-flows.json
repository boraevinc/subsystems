    "type": "function",
    "z": "tab_dash",
    "name": "Validate & send",
    "func": "// Apply pressed: validate against the spec ranges, then publish\nconst RANGES = {\n    temperature_C: [25, 35],\n    pH: [3, 7],\n    rpm: [500, 1500]\n};\nconst sp = flow.get('pending') || {};\nfor (const [key, [lo, hi]] of Object.entries(RANGES)) {\n    if (typeof sp[key] !== 'number' || sp[key] < lo || sp[key] > hi) {\n        return [null, { payload: `❌ ${key} must be between ${lo} and ${hi}` }];\n    }\n}\nflow.set('sentAt', Date.now());\nreturn [\n    { payload: sp },                                   // -> MQTT (sent as JSON)\n    { payload: '⏳ Sent - waiting for the device to confirm…' }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
