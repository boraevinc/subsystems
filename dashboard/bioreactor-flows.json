  {
    "id": "f_sim",
    "type": "function",
    "z": "tab_fake",
    "name": "Simulate bioreactor",
    "func": "// A very rough bioreactor model: each reading drifts towards its setpoint with noise.\nconst noise = (s) => (Math.random() - 0.5) * 2 * s;\nconst sp = flow.get('setpoints') || { temperature_C: 30, pH: 5, rpm: 1000 };\nconst st = flow.get('state') || { temperature_C: 18, pH: 7, rpm: 0 };\n\nst.temperature_C += (sp.temperature_C - st.temperature_C) * 0.03 + noise(0.05);  // slow\nst.pH            += (sp.pH - st.pH) * 0.08 + noise(0.02);                          // medium\nst.rpm           += (sp.rpm - st.rpm) * 0.4 + noise(6);                            // fast\nflow.set('state', st);\n\nconst r = (v, dp) => Number(v.toFixed(dp));\nconst clamp01 = (v) => Math.min(1, Math.max(0, v));\nreturn { payload: {\n    temperature_C: r(st.temperature_C, 2),\n    pH: r(st.pH, 2),\n    rpm: r(st.rpm, 0),\n    actuators: {\n        heater: r(clamp01((sp.temperature_C - st.temperature_C) / 2), 2),\n        motor: r(clamp01(st.rpm / 1500), 2),\n        acid_pump: st.pH > sp.pH + 0.05 ? 0.3 : 0,\n        base_pump: st.pH < sp.pH - 0.05 ? 0.3 : 0\n    },\n    setpoints: sp\n}};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
