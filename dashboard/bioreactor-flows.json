  {
    "id": "log_csv",
    "type": "function",
    "z": "tab_dash",
    "name": "Format CSV row",
    "func": "// Appends one CSV row per telemetry message.\n// A new file is started each time Node-RED starts: bioreactor-log-<date-time>.csv\nlet file = context.get('file');\nconst rows = [];\nif (!file) {\n    const stamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19);\n    file = `bioreactor-log-${stamp}.csv`;\n    context.set('file', file);\n    rows.push('time_iso,temperature_C,pH,rpm,sp_temperature_C,sp_pH,sp_rpm,' +\n              'heater,motor,acid_pump,base_pump,marker');\n}\nconst t = msg.payload;\nconst sp = t.setpoints || {};\nconst a = t.actuators || {};\nconst marker = flow.get('marker') || '';\nflow.set('marker', '');          // a marker is written on one row only\nrows.push([new Date().toISOString(), t.temperature_C, t.pH, t.rpm,\n           sp.temperature_C, sp.pH, sp.rpm,\n           a.heater, a.motor, a.acid_pump, a.base_pump, marker].join(','));\nnode.status({ text: file });\nreturn { filename: file, payload: rows.join('\\n') };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 1260,
    "wires": [
