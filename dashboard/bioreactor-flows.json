    "name": "Default setpoints",
    "func": "// Runs once at start-up: sets the default setpoints (spec: pH default 5)\nconst defaults = { temperature_C: 30, pH: 5, rpm: 1000 };\nflow.set('pending', defaults);\nreturn [\n    { payload: defaults.temperature_C },\n    { payload: defaults.pH },\n    { payload: defaults.rpm },\n    { payload: 'Defaults loaded - press Apply to send them' }\n];",
