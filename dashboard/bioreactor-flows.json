    "id": "chk_rpm",
    "type": "function",
    "z": "tab_dash",
    "name": "Check Stirring speed",
    "func": "// Spec for this parameter (from the Bioreactor Design Specification)\nconst KEY = 'rpm';          // field name in the telemetry JSON\nconst TOLERANCE = 20;      // allowed distance from the setpoint\nconst UNIT = 'RPM';\n\nconst t = msg.payload;\nconst reading = t[KEY];\nconst setpoint = t.setpoints ? t.setpoints[KEY] : null;\nif (typeof reading !== 'number') return null;   // ignore malformed messages\n\n// Output 1: gauge (just the number)\nconst gaugeMsg = { payload: reading };\n\n// Output 2: chart - one point for the reading, one for the setpoint\nconst chartMsgs = [{ topic: 'Reading', payload: reading }];\nif (typeof setpoint === 'number') chartMsgs.push({ topic: 'Setpoint', payload: setpoint });\n\n// Output 3: in-range status text\nlet status = 'No setpoint yet';\nif (typeof setpoint === 'number') {\n    const error = reading - setpoint;\n    const ok = Math.abs(error) <= TOLERANCE;\n    status = (ok ? '✅ In range' : '⚠️ Out of range') +\n             ` (setpoint ${setpoint} ${UNIT}, error ${error.toFixed(0)})`;\n}\nreturn [gaugeMsg, chartMsgs, { payload: status }];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
